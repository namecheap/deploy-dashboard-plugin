<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.jenkins.plugins</groupId>
    <artifactId>deploy-dashboard</artifactId>
    <version>0.2.2-SNAPSHOT</version>
    <packaging>hpi</packaging>

    <name>Deploy Dashboard Plugin by Namecheap</name>
    <description>
        Jenkins view dashboard that shows the information about which releases deployed to which environment.
    </description>
    <url>https://github.com/jenkinsci/deploy-dashboard-plugin</url>

    <properties>
        <jenkins.baseline>2.568</jenkins.baseline>
        <jenkins.version>${jenkins.baseline}.2</jenkins.version>
        <!--
            Kept in a property so the scheduled compatibility workflow can test
            the plugin against the newest BOM of this line without editing the
            POM: ./mvnw verify -Djenkins.version=<core> -Djenkins.bom.version=<bom>
        -->
        <jenkins.bom.version>6815.v1fb_2a_fee3765</jenkins.bom.version>
    </properties>

    <parent>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>plugin</artifactId>
        <version>6.2221.va_045130417c9</version>
        <relativePath />
    </parent>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The parent sets reuseForks=false, so every test class
                        already pays for a fresh JVM and a fresh Jenkins. With
                        the default forkCount of 1 those starts were serial,
                        and starting Jenkins, rather than running assertions,
                        is most of what this suite does.

                        Half the cores rather than one fork per core. On a
                        4-vCPU GitHub runner, 1C oversubscribes: measured on
                        CI with a warm cache, the linux leg went from 72s to
                        88s at 1C while windows went from 128s to 100s, since
                        process startup dominates there and compute does here.
                        0.5C is two forks on that hardware, which is where the
                        local numbers also stopped paying for themselves
                        (53s at 1, 38s at 2, 30s at 4 on ten cores).
                    -->
                    <forkCount>0.5C</forkCount>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.jenkins.tools.bom</groupId>
                <artifactId>bom-${jenkins.baseline}.x</artifactId>
                <version>${jenkins.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>ionicons-api</artifactId>
        </dependency>
        <!--
            workflow-multibranch was a compile dependency only because the view
            named WorkflowMultiBranchProject to decide how to find builds. It
            walks ItemGroups generically now, so every install no longer has to
            carry multibranch and its transitive Pipeline plugins to render a
            dashboard of freestyle jobs. It stays on the test classpath, where
            the multibranch case is still asserted.
        -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-multibranch</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-cps</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockSCMController, so the multibranch case can be built for real. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>scm-api</artifactId>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-basic-steps</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-durable-task-step</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/jenkinsci/deploy-dashboard-plugin.git</connection>
        <developerConnection>scm:git:git@github.com:jenkinsci/deploy-dashboard-plugin.git</developerConnection>
        <url>https://github.com/jenkinsci/deploy-dashboard-plugin</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>vetal2409</id>
            <name>Vitalii Sydorenko</name>
            <email>vitaliy.sidorenko@namecheap.com</email>
        </developer>
        <developer>
            <id>StyleT</id>
            <name>Vlad Fedosov</name>
            <email>vladlen.f@namecheap.com</email>
        </developer>
        <developer>
            <id>vetal2409</id>
            <name>Yuriy Puchkov</name>
            <email>yuriy.puchkov@namecheap.com</email>
        </developer>
    </developers>

    <repositories>
        <repository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </pluginRepository>
    </pluginRepositories>

    <distributionManagement>
        <repository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/releases</url>
        </repository>
    </distributionManagement>
</project>
