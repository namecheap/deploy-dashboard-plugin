  <scm>
    <connection>scm:git:https://github.com/jenkinsci/deploy-dashboard-plugin.git</connection>
    <developerConnection>scm:git:git@github.com:jenkinsci/deploy-dashboard-plugin.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/jenkinsci/deploy-dashboard-plugin</url>
  </scm>

  <distributionManagement>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/releases</url>
    </repository>
  </distributionManagement>

  <properties>
    <jenkins.baseline>2.568</jenkins.baseline>
    <!--
            .1, not a later point release. The baseline guide says to stay on
            the first release of the active LTS line unless something in a
            point release is actually needed, because every 2.568.x controller
            can then install this plugin. Nothing here needs .2 or .3: the full
            suite passes against 2.568.1. When 2.568 becomes a historical line
            the guide flips to the last release of it, and this becomes .3.
        -->
    <jenkins.version>${jenkins.baseline}.1</jenkins.version>
    <!--
            Kept in a property so the scheduled compatibility workflow can test
            the plugin against the newest BOM of this line without editing the
            POM: ./mvnw verify -Djenkins.version=<core> -Djenkins.bom.version=<bom>
        -->
    <jenkins.bom.version>7046.v43536164769c</jenkins.bom.version>

    <!--
      The gates the jenkinsci archetype turns on for every new plugin, all of
      which the parent POM ships switched off. The code already satisfies every
      one of them; the point is that it keeps doing so when someone pastes in an
      older snippet, rather than finding out when an API is finally removed.
    -->
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <spotless.check.skip>false</spotless.check.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>${jenkins.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>ionicons-api</artifactId>
    </dependency>
    <!-- MockSCMController, so the multibranch case can be built for real. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>scm-api</artifactId>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-durable-task-step</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
            workflow-multibranch was a compile dependency only because the view
            named WorkflowMultiBranchProject to decide how to find builds. It
            walks ItemGroups generically now, so every install no longer has to
            carry multibranch and its transitive Pipeline plugins to render a
            dashboard of freestyle jobs. It stays on the test classpath, where
            the multibranch case is still asserted.
        -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-multibranch</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
                        The parent sets reuseForks=false, so every test class
                        already pays for a fresh JVM and a fresh Jenkins. With
                        the default forkCount of 1 those starts were serial,
                        and starting Jenkins, rather than running assertions,
                        is most of what this suite does.

                        Measured on CI, warm cache only, "Build and test":

                          linux    1 fork: 72 83 85 85 97   (median 85s)
                                   forked: 86, 88           (no change)
                          windows  1 fork: 110 120 121 128
                                           131 134 149 157  (median 130s)
                                   forked: 100, 103         (under the best
                                                             of the eight)

                        So this buys nothing on linux and about 25 seconds on
                        windows, which is the leg that sets the wall clock.
                        Process startup dominates there while linux is already
                        compute-bound, which is the asymmetry being exploited.

                        0.5C rather than 1C: on a 4-vCPU runner they measured
                        the same (86 vs 88, 103 vs 100), so take the setting
                        that leaves headroom. Do not read the local numbers
                        (53s at 1, 38s at 2, 30s at 4 on ten cores) as a guide
                        to CI; a laptop has more cores than a runner and they
                        do not transfer.
                    -->
          <forkCount>0.5C</forkCount>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
