<settings xmlns="https://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="https://maven.apache.org/SETTINGS/1.0.0
                      https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>repo.jenkins-ci.org</id>
            <!--
                Read straight from the environment, so the credentials never
                appear on a command line. They used to arrive as -Drepo.login /
                -Drepo.pwd, which put them in the agent's process list.
            -->
            <username>${env.RELEASE_USERNAME}</username>
            <password>${env.RELEASE_PASSWORD}</password>
        </server>
    </servers>

</settings>