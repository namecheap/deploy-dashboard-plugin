<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout"
         xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:i="jelly:fmt">

    <!--
      jenkins-table, not the pane/bigtable/stripped-odd classes this view used
      to carry. Core still ships CSS for those, but only as legacy
      compatibility: none of core's own current views use them, and every UI
      refresh has removed a few more. When the last of them goes, a dashboard
      built on them does not break loudly, it just quietly loses its striping,
      borders and spacing, which no test would notice.

      The release history is emitted as a <template> per environment and opened
      through core's dialog, rather than pre-rendered into hidden divs styled by
      our own CSS. That stylesheet hardcoded a white panel and a black header,
      so the history was unreadable in dark theme; core's dialog is themed by
      core, which is the point of using it.
    -->
    <st:adjunct includes="org.jenkinsci.plugins.environmentdashboard.DeploymentView.dashboard"/>

    <j:set var="views" value="${it.owner.views}"/>
    <j:set var="currentView" value="${it}"/>
    <j:choose>
        <j:when test="${empty(it.items)}">
            <j:if test="${!empty(app.items)}">
                <st:include page="viewTabs.jelly" it="${it.owner.viewsTabBar}"/>
            </j:if>
            <st:include page="noJob.jelly"/>
        </j:when>
        <j:otherwise>
            <st:include page="viewTabs.jelly" it="${it.owner.viewsTabBar}"/>
            <j:set var="units" value="${it.getUnits(it.items)}"/>
            <table class="jenkins-table jenkins-table--medium">
                <thead>
                    <tr>
                        <th class="jenkins-table__cell--tight"><span class="jenkins-visually-hidden">Expand</span></th>
                        <th>Job</th>
                        <th>Environment</th>
                        <th>Release</th>
                        <th>Result</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <j:forEach var="unit" indexVar="i" items="${units}">
                    <tbody class="edb-job">
                        <tr>
                            <td class="jenkins-table__cell--tight">
                                <button type="button" class="jenkins-button jenkins-button--tertiary edb-toggle"
                                        data-edb-toggle="edb-envs-${i}" aria-controls="edb-envs-${i}"
                                        aria-expanded="true">
                                    <l:icon class="symbol-chevron-down-outline plugin-ionicons-api"/>
                                </button>
                            </td>
                            <td>
                                <a class="jenkins-table__link" href="${unit.getJob().getAbsoluteUrl()}">${unit.getJob().name}</a>
                            </td>
                            <td>${unit.getEnvironments().size()} environment(s)</td>
                            <td>
                                <a class="jenkins-table__link" href="${unit.getNewestDeployment().run.getAbsoluteUrl()}">
                                    ${unit.getNewestDeployment().buildNumber}
                                </a>
                            </td>
                            <td class="jenkins-table__cell--tight">
                                <l:icon alt="${unit.getNewestDeployment().run.description}"
                                        class="${unit.getNewestDeployment().run.buildStatusIconClassName} icon-lg"/>
                            </td>
                            <td>${unit.getNewestDeployment().run.timestampString}</td>
                        </tr>
                    </tbody>
                    <tbody class="edb-job-envs" id="edb-envs-${i}">
                        <j:forEach var="environment" indexVar="j" items="${unit.getEnvironments()}">
                            <tr>
                                <td class="jenkins-table__cell--tight"/>
                                <td/>
                                <td>
                                    <a href="#" class="edb-popup-toggle jenkins-table__link"
                                       data-popup-id="popup_${i}_${j}"
                                       data-popup-title="${unit.getJob().name} | ${environment.getName()}">
                                        ${environment.getName()}
                                    </a>
                                </td>
                                <td>
                                    <a class="jenkins-table__link" href="${environment.getCurrentAction().run.getAbsoluteUrl()}">
                                        ${environment.getCurrentAction().buildNumber}
                                    </a>
                                </td>
                                <td class="jenkins-table__cell--tight">
                                    <l:icon alt="${environment.getCurrentAction().run.description}"
                                            class="${environment.getCurrentAction().run.buildStatusIconClassName} icon-lg"/>
                                </td>
                                <td>
                                    ${environment.getCurrentAction().run.timestampString}
                                </td>
                            </tr>
                        </j:forEach>
                    </tbody>
                </j:forEach>
            </table>

            <j:forEach var="unit" indexVar="i" items="${units}">
                <j:forEach var="environment" indexVar="j" items="${unit.getEnvironments()}">
                    <template id="popup_${i}_${j}">
                        <table class="jenkins-table jenkins-table--medium">
                            <thead>
                                <tr>
                                    <th>Release</th>
                                    <th>Result</th>
                                    <th>Completed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <j:forEach var="deployment" items="${environment.getActions()}">
                                    <tr>
                                        <td>
                                            <a class="jenkins-table__link" href="${deployment.run.getAbsoluteUrl()}">
                                                ${deployment.buildNumber}
                                            </a>
                                        </td>
                                        <td class="jenkins-table__cell--tight">
                                            <l:icon alt="${deployment.run.description}"
                                                    class="${deployment.run.buildStatusIconClassName} icon-lg"/>
                                        </td>
                                        <td>
                                            ${deployment.run.timestampString}
                                        </td>
                                    </tr>
                                </j:forEach>
                            </tbody>
                        </table>
                        <j:if test="${environment.truncated}">
                            <p class="edb-history-truncated">
                                Showing the most recent ${environment.actions.size()}
                                of ${environment.totalCount} deployments.
                            </p>
                        </j:if>
                    </template>
                </j:forEach>
            </j:forEach>

        </j:otherwise>
    </j:choose>
</j:jelly>
