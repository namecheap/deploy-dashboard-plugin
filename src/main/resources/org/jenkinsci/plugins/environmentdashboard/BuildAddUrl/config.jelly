<?jelly escape-by-default='true'?>
<!--
  The step had no form, so freestyle configuration and the Snippet Generator
  both rendered an empty panel.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Title" field="title">
        <f:textbox/>
    </f:entry>
    <f:entry title="URL" field="url">
        <f:textbox/>
    </f:entry>
    <f:optionalProperty title="Restrict who is shown this link" field="visibleTo"/>
</j:jelly>
