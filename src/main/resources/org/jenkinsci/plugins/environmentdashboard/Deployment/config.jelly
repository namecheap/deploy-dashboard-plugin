<?jelly escape-by-default='true'?>
<!--
  The build step had no form at all: freestyle configuration and the pipeline
  Snippet Generator both rendered an empty panel, so the only way to use the
  step was to write the call by hand. The `field` attributes also wire up
  doCheckEnv/doCheckBuildNumber, which is where a missing value is now caught
  before a build is ever run.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Environment" field="env">
        <f:textbox/>
    </f:entry>
    <f:entry title="Release" field="buildNumber">
        <f:textbox/>
    </f:entry>
</j:jelly>
